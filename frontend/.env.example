# Where the browser should send API calls.
#
# Leave it unset (or empty) to use the same origin: the Vite dev server and the nginx image
# proxy /classes, /holds, /me and /health to the backend, so no CORS is involved.
#
# Set it when the UI and the API live on different hosts, e.g.:
# VITE_API_BASE_URL=http://localhost:8080

VITE_API_BASE_URL=

# Only used by `npm run dev`: where the dev-server proxy forwards the API paths.
# VITE_PROXY_TARGET=http://localhost:8080
